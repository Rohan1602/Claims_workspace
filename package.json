{
  "name": "claims-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "gen:data": "node scripts/generate-claims.mjs",
    "test": "npm run test:documents && npm run test:rbac && npm run test:handlers",
    "test:documents": "tsx scripts/test-documents-store.ts",
    "test:rbac": "tsx scripts/test-rbac.ts",
    "test:handlers": "tsx scripts/test-handlers-live.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-virtual": "^3.10.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "msw": "^2.6.5",
    "tsx": "^4.23.11",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
